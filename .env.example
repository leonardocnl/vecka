# Conexão direta do Neon (migrations, drizzle-kit)
DATABASE_URL=
# Conexão com pooler (o app)
DATABASE_URL_POOLED=
# Origem pública do app, sem barra final (produção: https://dievecka.vercel.app)
APP_URL=http://localhost:3000
# Cliente OAuth do Google ("Aplicativo da Web"); redirecionamento:
# http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Quem pode entrar, separados por vírgula. Vazio = ninguém.
ALLOWED_EMAILS=
